@startuml
title JoinUp-POO — GoF: Entregas 00/01 implementadas; Facade prevista para 02
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members
left to right direction

package "Facade — Criar e editar evento" {
  class EventoFacade <<Facade>> {
    +criarEvento(dados, organizadorId): Evento
    +editarEvento(eventoId, dados, organizadorId): Evento
  }
  class EventoService <<Subsystem>> {
    +criarEvento(conexao, dados): Evento
    +editarEvento(conexao, eventoId, dados): Evento
  }
  class ArtistaService <<Subsystem>> {
    +sincronizarLineup(conexao, eventoId, artistas): void
  }
  class TipoIngressoService <<Subsystem>> {
    +cadastrarTipos(conexao, eventoId, tipos): void
    +validarEdicaoSemVendas(conexao, tipoId): void
  }
  class ComunidadeService <<Subsystem>> {
    +criarParaEvento(conexao, eventoId): Comunidade
  }
  class ExecutorTransacional <<Infrastructure>> {
    +executar(operacao): Resultado
  }
  EventoFacade --> ExecutorTransacional
  EventoFacade --> EventoService
  EventoFacade --> ArtistaService
  EventoFacade --> TipoIngressoService
  EventoFacade --> ComunidadeService
}

package "Template Method — Login" {
  abstract class AutenticacaoTemplate <<AbstractClass>> {
    +{final} autenticar(credenciais: Credenciais): SessaoEmitida
    #buscarUsuario(conexao: Connection, email: String): Usuario
    #validarRegraDoPerfil(usuario): void
  }
  class AutenticacaoParticipante <<ConcreteClass>>
  class AutenticacaoOrganizador <<ConcreteClass>>
  class AutenticacaoSuporte <<ConcreteClass>>
  interface VerificadorSenha {
    +verificar(senha, hash): boolean
  }
  class GerenciadorSessao {
    +criar(conexao: Connection, usuario: Usuario): SessaoEmitida
    +exigir(conexao: Connection, token: String, perfis: Perfil[]): Usuario
  }
  AutenticacaoTemplate <|-- AutenticacaoParticipante
  AutenticacaoTemplate <|-- AutenticacaoOrganizador
  AutenticacaoTemplate <|-- AutenticacaoSuporte
  AutenticacaoTemplate --> VerificadorSenha
  AutenticacaoTemplate --> GerenciadorSessao
}

package "Factory Method — Cadastro" {
  abstract class Usuario <<Product>> {
    +id: Long
    +email: String
    +ativo: boolean
  }
  class Participante <<ConcreteProduct>>
  class Organizador <<ConcreteProduct>>
  class UsuarioSuporte <<ConcreteProduct>>
  abstract class CadastroUsuarioCreator <<Creator>> {
    +{final} cadastrar(dados: CadastroDados, tokenOperador: String): Usuario
    #criarUsuario(dados: CadastroDados, hashSenha: String): Usuario
  }
  class CadastroParticipanteCreator <<ConcreteCreator>>
  class CadastroOrganizadorCreator <<ConcreteCreator>>
  class CadastroSuporteCreator <<ConcreteCreator>>
  interface UsuarioRepository {
    +salvar(conexao: Connection, usuario: Usuario): long
    +buscarId(conexao: Connection, id: long, bloquear: boolean): Usuario
    +buscarEmail(conexao: Connection, email: String, bloquear: boolean): Usuario
  }
  Usuario <|-- Participante
  Usuario <|-- Organizador
  Usuario <|-- UsuarioSuporte
  CadastroUsuarioCreator <|-- CadastroParticipanteCreator
  CadastroUsuarioCreator <|-- CadastroOrganizadorCreator
  CadastroUsuarioCreator <|-- CadastroSuporteCreator
  CadastroUsuarioCreator ..> Usuario : cria (factory method)
  CadastroUsuarioCreator --> UsuarioRepository : persiste
  CadastroParticipanteCreator ..> Participante : instancia
  CadastroOrganizadorCreator ..> Organizador : instancia
  CadastroSuporteCreator ..> UsuarioSuporte : instancia
}

package "Singleton — Configuração" {
  class ConfiguracaoSistema <<Singleton>> {
    -ConfiguracaoSistema()
    +{static} getInstancia(): ConfiguracaoSistema
    +getPortaHttp(): int
    +getLimiteRequisicaoBytes(): int
    +getOrigemPublica(): String
    +isModoDemo(): boolean
  }
  class ApplicationBootstrap
  ApplicationBootstrap ..> ConfiguracaoSistema : obtém única instância
}

note bottom of CadastroSuporteCreator
  Cadastro de suporte somente após
  autorização de suporte autenticado.
  Controle obrigatório no backend.
end note

note bottom of AutenticacaoTemplate
  Algoritmo final: normalizar, buscar conta do perfil,
  verificar senha e status ativo,
  validar regra específica e criar sessão.
end note

note top of EventoFacade
  PROPOSTA para Entrega 02.
  Nenhuma classe Facade foi criada na Entrega 01.
end note

note bottom of ConfiguracaoSistema
  Imutável e thread-safe.
  Não armazenar Connection, sessão,
  usuário logado ou estado de compra.
end note

@enduml
