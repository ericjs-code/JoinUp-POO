# Referência somente: a aplicação NÃO carrega .env automaticamente.
# Exporte no shell ou use propriedades -Djoinup.* (veja README).
JOINUP_HTTP_HOST=127.0.0.1
JOINUP_HTTP_PORT=8080
JOINUP_HTTP_THREADS=8
JOINUP_MAX_REQUEST_BYTES=65536
JOINUP_DEMO=false
# Para demo automática local: JOINUP_ENV=demo e JOINUP_DEMO=true.
JOINUP_ENV=local
# Caminho absoluto fora do repositório/webroot; vazio não é recomendado.
# JOINUP_UPLOAD_DIR=C:/Users/seu-usuario/.joinup/uploads
JOINUP_JDBC_URL=jdbc:mysql://127.0.0.1:3306/joinup_poo?connectionTimeZone=UTC&connectTimeout=5000&socketTimeout=10000
JOINUP_DB_USER=
JOINUP_DB_PASSWORD=
# Mesma origem da API/frontend; em HTTPS habilita cookie Secure. Sem barra final.
JOINUP_PUBLIC_ORIGIN=
JOINUP_PBKDF2_ITERATIONS=600000
JOINUP_SESSION_SECONDS=28800
